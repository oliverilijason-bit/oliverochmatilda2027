---
import { navigation } from '../data/navigation';
const { currentPath } = Astro.props;
const index = navigation.findIndex((page) => page.href === currentPath);
const previous = index > 0 ? navigation[index - 1] : undefined;
const next = index >= 0 ? navigation[index + 1] : undefined;
---

{index >= 0 && (
  <nav class="page-navigation" aria-label="Föregående och nästa sida">
    {previous && <a class="previous" href={previous.href} rel="prev"><span class="direction">← Föregående</span><span class="page-name">{previous.title}</span></a>}
    {next && <a class="next" href={next.href} rel="next"><span class="direction">Nästa →</span><span class="page-name">{next.title}</span></a>}
  </nav>
)}

<style>
  .page-navigation { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(20px,4vw,48px); margin-top:clamp(40px,6vw,64px); padding-top:20px; border-top:1px solid var(--border); }
  a { display:flex; flex-direction:column; gap:8px; min-width:0; min-height:44px; padding-block:12px; color:var(--burgundy); text-decoration:none; overflow-wrap:anywhere; }
  .previous { grid-column:1; }
  .next { grid-column:2; text-align:right; }
  .direction { font-size:.65rem; font-weight:700; letter-spacing:.16em; text-transform:uppercase; }
  .page-name { font-family:Georgia,'Times New Roman',serif; font-size:clamp(1.1rem,2vw,1.4rem); line-height:1.3; }
  a:hover .page-name { text-decoration:underline; text-underline-offset:4px; }
  a:focus-visible { outline:2px solid var(--burgundy); outline-offset:4px; }
</style>
