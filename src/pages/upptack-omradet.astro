---
import Layout from '../layouts/Layout.astro';

const categories = [
  { label: 'SPA', title: 'Ta det lugnt på Höörs Gästis', text: 'För er som vill börja bröllopsdagen riktigt lugnt finns möjligheten att boka in några timmar på spa på Höörs Gästis – perfekt för den som hellre laddar batterierna än ger sig ut på äventyr.', image: '/images/upptack/area-spa.svg' },
  { label: 'EN LITEN UTFLYKT', title: 'Upptäck Lund', text: 'Ta en tur till Lund och upptäck staden där vi båda tillbringade våra studieår. Strosa genom centrum, ta en kaffe och kika förbi några av platserna som varit en stor del av våra liv.', note: 'Ca 35–40 minuter från Höör.', image: '/images/upptack/area-lund.svg' },
  { label: 'BOSJÖKLOSTER', title: 'Promenera bland getter och lamor', text: 'Ta en lugn promenad i Bosjöklosters vackra omgivningar och passa på att hälsa på djuren i parken. Ett enkelt och mysigt sätt att få lite frisk luft innan det är dags att göra sig redo.', image: '/images/upptack/area-bosjokloster.svg' },
  { label: 'OM SOLEN SKINER', title: 'Ta ett dopp i Ringsjön', text: 'Om augustivädret visar sig från sin bästa sida finns det få bättre sätt att börja dagen än med ett dopp i Ringsjön.', note: 'Glöm bara inte att lämna tid för hår, kostym och bubbel efteråt.', image: '/images/upptack/area-ringsjon.svg' },
  { label: 'LUNCH', title: 'Lunch på Björk Ringsjön', text: 'Ät lunch på Björk Ringsjön, ett av våra favoritställen i området. Här serveras framför allt fisk och skaldjur med utsikt över Ringsjön – perfekt för en lång och lugn lunch innan bröllopet.', note: 'En av våra egna favoriter.', image: '/images/upptack/area-bjork.svg', featured: true },
];

---

<Layout title="Upptäck området">
  <div class="area-page">
    <section class="area-hero">
      <img src="/images/upptack/hero.svg" alt="Dekorativ bildyta för trakten kring Bosjökloster" />
      <div class="area-hero__shade"></div>
      <div class="area-hero__content">
        <p class="kicker">EN FÖRMIDDAG I SKÅNE</p>
        <h1>Upptäck trakten</h1>
        <p class="intro">Lördagsförmiddagen är helt er egen. För er som vill upptäcka lite av området innan det är dags att göra sig redo har vi samlat några idéer för en lugn och härlig förmiddag i trakterna kring Höör och Bosjökloster.</p>
        <p class="aside">Ta ett dopp, hitta en lång frukost eller gör absolut ingenting alls.</p>
      </div>
    </section>

    <section class="inspiration" aria-labelledby="inspiration-title">
      <header class="section-heading"><p class="kicker">ER FÖRMIDDAG, ERA VAL</p><h2 id="inspiration-title">Något för varje humör</h2></header>
      <div class="category-grid">
        {categories.map((category) => (
          <article class="category-card">
            <img src={category.image} alt="" loading="lazy" />
            <div class="category-card__copy">
              <p class="category-label">{category.label}</p>
              <h3>{category.title}</h3>
              <p>{category.text}</p>
              {category.note && <p class="category-note">{category.note}</p>}
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .area-page { --cream:#f8f4ed; --powder:#eedfd9; --ink:#292522; color:var(--ink); }
  .area-page section { margin-bottom:clamp(54px,7vw,88px); }
  .area-hero { position:relative; width:100vw; min-height:min(780px,86vh); margin-top:-40px; margin-left:calc(50% - 50vw); display:grid; place-items:end center; overflow:hidden; }
  .area-hero > img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .area-hero__shade { position:absolute; inset:0; background:linear-gradient(180deg,rgba(31,24,21,.1) 15%,rgba(30,21,22,.78) 100%); }
  .area-hero__content { position:relative; z-index:1; max-width:850px; padding:clamp(72px,10vw,120px) 24px clamp(48px,6vw,76px); text-align:center; color:#fff; }
  .kicker { margin:0 0 20px; color:var(--burgundy); font-size:.72rem; font-weight:700; letter-spacing:.3em; text-transform:uppercase; }
  .area-hero .kicker { color:rgba(255,255,255,.75); }
  .area-hero h1 { margin:0; font-family:Georgia,'Times New Roman',serif; font-size:clamp(3.4rem,8vw,7rem); font-weight:400; line-height:.95; }
  .area-hero .intro { max-width:740px; margin:30px auto 0; color:rgba(255,255,255,.9); font-size:clamp(1rem,1.6vw,1.2rem); line-height:1.75; }
  .area-hero .aside { margin:24px 0 0; color:var(--powder); font-family:Georgia,'Times New Roman',serif; font-size:1.05rem; font-style:italic; }
  .section-heading { max-width:650px; margin-bottom:34px; }
  .section-heading h2 { margin:0; color:var(--ink); font-family:Georgia,'Times New Roman',serif; font-size:clamp(2.5rem,5vw,4.3rem); font-weight:400; line-height:1.05; }
  .section-heading > p:last-child { margin:18px 0 0; }
  .category-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:clamp(26px,4vw,48px) clamp(24px,4vw,48px); }
  .category-card img { display:block; width:100%; aspect-ratio:4/3; object-fit:cover; }
  .category-card:nth-child(even) { margin-top:54px; }
  .category-card__copy { max-width:520px; padding:25px 8px 0; }
  .category-label { margin:0 0 10px; color:var(--burgundy); font-size:.7rem; font-weight:700; letter-spacing:.25em; }
  .category-card h3 { margin:0; color:var(--ink); font-family:Georgia,'Times New Roman',serif; font-size:clamp(1.7rem,3vw,2.35rem); font-weight:400; line-height:1.12; }
  .category-card__copy > p:last-child { margin:14px 0 0; line-height:1.75; }
  .category-note { color:var(--burgundy); font-family:Georgia,'Times New Roman',serif; font-size:.95rem; font-style:italic; }
  .category-card:last-child { grid-column:1/-1; display:grid; grid-template-columns:minmax(0,1.55fr) minmax(280px,.8fr); align-items:center; margin-top:10px; background:rgba(238,223,217,.38); }
  .category-card:last-child img { aspect-ratio:16/9; min-height:420px; }
  .category-card:last-child .category-card__copy { padding:clamp(30px,5vw,62px); }
  @media (max-width:850px) { .category-card:last-child { grid-template-columns:1fr; } .category-card:last-child img { min-height:0; } }
  @media (max-width:620px) { .area-hero { min-height:720px; } .category-grid { grid-template-columns:1fr; } .category-card:nth-child(even) { margin-top:0; } .category-card:last-child { display:block; margin-top:0; background:transparent; } .category-card:last-child .category-card__copy { padding:25px 8px 0; } .category-grid { gap:42px; } }
</style>
